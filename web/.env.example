# คัดลอกเป็น .env.local แล้วใส่ค่า (ไฟล์ .env.local ไม่ขึ้น git)
API_URL=http://localhost:8080
# สร้างค่าสุ่ม: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (อย่าใช้ npx auth secret — ตอนนี้ไปเรียกแพ็กเกจของ better-auth และได้ชื่อตัวแปรที่ NextAuth ไม่อ่าน)
AUTH_SECRET=
AUTH_TRUST_HOST=true
